# Platform
CONFIG_MACH_XIAOMI_C3J=y

# Backlight
CONFIG_BACKLIGHT_KTD3136=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_GF3208=y

# NFC
CONFIG_NFC_NQ=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_C3J=y
CONFIG_TOUCHSCREEN_FTS_C3J=y
CONFIG_TOUCHSCREEN_XIAOMI_C3J=y
# KernelSU-Next + SUSFS v2.0.0 (de-inlined)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_KPROBES_HOOK is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
# Clang 18 compat: novos warnings que viraram erro
CONFIG_CC_DISABLE_WARN_MAYBE_UNINITIALIZED=y
